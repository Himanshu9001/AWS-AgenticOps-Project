{
  "openapi": "3.0.0",
  "info": {
    "title": "ResearchAgent",
    "version": "1.0.0"
  },
  "paths": {
    "/research": {
      "post": {
        "operationId": "researchTopic",
        "description": "Research current information from the web for recent AWS features, announcements, external documentation, or anything not in the internal knowledge base.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The research question to investigate"
                  }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Research result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "answer": {"type": "string"},
                    "toolsUsed": {"type": "array", "items": {"type": "string"}},
                    "durationMs": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
